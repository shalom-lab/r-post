# 复制为 wechat/.env 后填写，不要提交。

# —— Token 中控：只要 access_token，不是发草稿、不是群发 ——
# 请求：{TOKEN_CENTER_URL}/access_token/{appName}
TOKEN_CENTER_URL=http://127.0.0.1:8795
TOKEN_CENTER_API_KEY=

# —— 国内发布中转 wechat-release-server：目前草稿流程不用 ——
# 以后 freepublish / mass sendall 才走这里（微信认请求 IP，不能从海外 runner 直发）。
# 不要叫 TOKEN_CENTER，也不要和中控地址填成同一个。
# RELAY_URL=
# RELAY_API_KEY=
